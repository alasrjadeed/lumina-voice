# Supabase — public URL and publishable key from Project → Connect → Framework
# → React → Vite. Both are safe to ship in a static build; never use a
# service-role key here. VITE_SUPABASE_ANON_KEY is still accepted as fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Static snapshot published by `npm run catalogue:export` (cron on the local
# server). Leave empty to read /catalogue.json from the same origin.
VITE_CATALOGUE_SNAPSHOT_URL=

# Radio feature switch — false keeps the radio pages/tabs hidden and makes no stream calls
VITE_RADIO_ENABLED=false

# Local broadcast server (AzuraCast on the CasaOS host)
VITE_AZURACAST_BASE_URL=http://192.168.1.166:8080
VITE_STREAM_LISTEN_BASE=http://192.168.1.166:8080
VITE_AZURACAST_SHORTCODE=lumina_voice
VITE_AZURACAST_STATION_ID=2
VITE_AZURACAST_API_KEY=

# Optional exact mount URL from AzuraCast (overrides generated mounts)
VITE_STREAM_LISTEN_URL=

# Structured logs (pino) and Sentry alerts — alerts stay off without a DSN
VITE_LOG_LEVEL=warn
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_VERSION=1.0.0

# Legacy external station (unused when the local server is configured)
VITE_RADIO_STREAM_URL=
VITE_AZURACAST_API_URL=
